# ---- Universe ----
TICKERS=NVDA,TSLA,GOOGL,AAPL,MSFT,AMZN

# ---- Kafka ----
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_BOOTSTRAP_INTERNAL=kafka:29092
TOPIC_PREFIX=tp

# ---- MongoDB (any MongoDB URI: local or hosted) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tickerpulse

# ---- Polling intervals (seconds) ----
PRICE_INTERVAL=60
SOCIAL_INTERVAL=120
NEWS_INTERVAL=300

# ---- Optional LLM analyst (any OpenAI-compatible chat API) ----
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Optional report delivery (generic JSON webhook) ----
REPORT_WEBHOOK_URL=
